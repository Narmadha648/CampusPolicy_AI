# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://campuspolicy:campuspolicypass@localhost:5432/campuspolicy
SYNC_DATABASE_URL=postgresql://campuspolicy:campuspolicypass@localhost:5432/campuspolicy

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
COOKIE_SECURE=false          # set true in production (requires HTTPS)
COOKIE_SAMESITE=lax          # strict | lax | none

# ── Groq ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192
GROQ_TIMEOUT_SECONDS=60

# ── Embedding model ────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2   # any sentence-transformers compatible model

# ── Chunking / retrieval ───────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_CHUNKS_PER_QUERY=6
SIMILARITY_THRESHOLD=0.35

# ── File upload ────────────────────────────────────────────────────────────────
UPLOAD_DIR=../data/uploads
MAX_UPLOAD_MB=50

# ── FAISS index ────────────────────────────────────────────────────────────────
FAISS_INDEX_DIR=../data/faiss_index

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Rate limiting ─────────────────────────────────────────────────────────────
AUTH_RATE_LIMIT=20/minute
CHAT_RATE_LIMIT=30/minute

# ── First admin (used only by create-admin command) ────────────────────────────
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=System Administrator
